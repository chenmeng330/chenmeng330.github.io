---
import Base from "../layouts/Base.astro";
import { allTexts, fmtDate, kindMeta } from "../lib/texts";

const latest = (await allTexts()).slice(0, 6);

const thresholds = [
  {
    href: "/works/",
    kicker: "Works",
    title: "作品",
    desc: "各种各样无聊的墨水。",
  },
  {
    href: "/gallery/",
    kicker: "Gallery",
    title: "图画",
    desc: "某人手绘的尝试。",
  },
  {
    href: "/misc/",
    kicker: "Miscellany",
    title: "杂项",
    desc: "各种乱七八糟的东西。",
  },
  {
    href: "/essays/",
    kicker: "Essays",
    title: "随笔",
    desc: "某人的杂笔与“她”的部分日志。",
  },
];
---

<Base>
  <section class="hero wrap">
    <p class="eyebrow">广州 · 写作者</p>
    <h1>秦羲子</h1>
    <p class="lede">
      为二十二世纪鸣响第一门礼炮
    </p>
    <span class="rule-dot"></span>
  </section>

  <nav class="thresholds wrap-wide" aria-label="栏目">
    {
      thresholds.map((t) => (
        <a href={t.href}>
          <p class="kicker">{t.kicker}</p>
          <h2>{t.title}</h2>
          <p>{t.desc}</p>
        </a>
      ))
    }
  </nav>

  <section class="wrap-wide">
    <div class="section-head">
      <h2>近作</h2>
      <a class="more" href="/works/">全部 →</a>
    </div>
    <ul class="entries">
      {
        latest.map((t) => (
          <li>
            <a class="entry" href={`/${t.data.slug}/`}>
              <time datetime={t.data.date?.toISOString()}>
                {fmtDate(t.data.date)}
              </time>
              <h3 class="title">
                {t.data.title}
                {t.data.category && <span class="tag">{t.data.category}</span>}
              </h3>
              {t.data.summary && <p class="desc">{t.data.summary}</p>}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
