---
import Base from "../layouts/Base.astro";
import { allTexts, fmtDate, kindMeta } from "../lib/texts";

const latest = (await allTexts()).slice(0, 6);

const thresholds = [
  {
    href: "/fiction/",
    kicker: "Fiction",
    title: "作品",
    desc: "原创短篇、长篇，和东方同人。",
  },
  {
    href: "/longform/",
    kicker: "Longform",
    title: "长文",
    desc: "考据、杂论，和一些太长了的东西。",
  },
  {
    href: "/essays/",
    kicker: "Essays",
    title: "随笔",
    desc: "日常、碎片，没头没尾的话。",
  },
];
---

<Base>
  <section class="hero wrap">
    <p class="eyebrow">广州 · 写作者</p>
    <h1>秦羲子</h1>
    <p class="lede">
      我写小说，也写些没人考证的旧事。喜欢民俗、宗教，和一切人留下的痕迹。
    </p>
    <span class="rule-dot"></span>
  </section>

  <nav class="thresholds wrap-wide" aria-label="栏目">
    {
      thresholds.map((t) => (
        <a href={t.href}>
          <p class="kicker">{t.kicker}</p>
          <h2>{t.title}</h2>
          <p>{t.desc}</p>
        </a>
      ))
    }
  </nav>

  <section class="wrap-wide">
    <div class="section-head">
      <h2>近作</h2>
      <a class="more" href="/fiction/">全部 →</a>
    </div>
    <ul class="entries">
      {
        latest.map((t) => (
          <li>
            <a class="entry" href={`/${t.data.slug}/`}>
              <time datetime={t.data.date?.toISOString()}>
                {fmtDate(t.data.date)}
              </time>
              <h3 class="title">
                {t.data.title}
                {t.data.category && <span class="tag">{t.data.category}</span>}
              </h3>
              {t.data.summary && <p class="desc">{t.data.summary}</p>}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
