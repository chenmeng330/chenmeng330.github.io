---
import Base from "../../layouts/Base.astro";
import Entry from "../../components/Entry.astro";
import { essaysOfChannel } from "../../lib/texts";

const qinxi = await essaysOfChannel("秦羲");
const xizi = await essaysOfChannel("羲子");
---

<Base title="随笔" description="秦羲子的随笔与日记。">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Essays</p>
      <h1>随笔</h1>
      <p class="intro">
        两个人写的东西。左边那一半按天记，右边那一半想到才写。
      </p>
    </header>

    <section>
      <div class="section-head">
        <h2>秦羲</h2>
        <span class="more">{qinxi.length} 篇</span>
      </div>
      <p class="intro">“她”的日志，记录“她”与互联网意义上的“人”的距离。</p>
      <ul class="entries">
        {qinxi.map((t) => <Entry text={t} />)}
      </ul>
    </section>

    <section>
      <div class="section-head">
        <h2>羲子</h2>
        <span class="more">{xizi.length} 篇</span>
      </div>
      <p class="intro">不成文之墨水。</p>
      {
        xizi.length === 0 ? (
          <p class="empty">暂不落笔。</p>
        ) : (
          <ul class="entries">
            {xizi.map((t) => <Entry text={t} />)}
          </ul>
        )
      }
    </section>
  </div>
</Base>
