---
import Base from "../../layouts/Base.astro";
import Entry from "../../components/Entry.astro";
import { groupByCategory, textsOf } from "../../lib/texts";

const items = await textsOf("longform");
const groups = groupByCategory(items, ["考据", "杂论", "长篇记述"]);
---

<Base title="长文" description="秦羲子的考据、杂论与长篇记述。">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Longform</p>
      <h1>长文</h1>
      <p class="intro">考据、杂论，和一些一次说不完的事。</p>
    </header>

    {
      groups.map((g) => (
        <section>
          <div class="section-head">
            <h2>{g.category}</h2>
            <span class="more">{g.items.length} 篇</span>
          </div>
          <ul class="entries">
            {g.items.map((t) => (
              <Entry text={t} />
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
