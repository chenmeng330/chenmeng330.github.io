---
import Base from "../../layouts/Base.astro";
import Entry from "../../components/Entry.astro";
import { textsOf } from "../../lib/texts";

const items = await textsOf("misc");
---

<Base title="杂项" description="秦羲子的杂项。">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Miscellany</p>
      <h1>杂项</h1>
      <p class="intro">
        放不进另外几栏的东西。笔记、整理、随手记下的。有了就往这儿丢。
      </p>
    </header>

    {
      items.length === 0 ? (
        <p class="empty">
          还空着。这一栏是给以后那些不知道该往哪儿塞的东西留的。
        </p>
      ) : (
        <ul class="entries">
          {items.map((t) => (
            <Entry text={t} />
          ))}
        </ul>
      )
    }
  </div>
</Base>
