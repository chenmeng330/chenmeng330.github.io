---
import Base from "../../layouts/Base.astro";
import Entry from "../../components/Entry.astro";
import { textsOf } from "../../lib/texts";

const items = await textsOf("misc");
---

<Base title="杂项" description="秦羲子的杂项。">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Miscellany</p>
      <h1>杂项</h1>
      <p class="intro">
        不算文章的文字，就放在这儿了。
      </p>
    </header>

    {
      items.length === 0 ? (
        <p class="empty">
          此处留白。
        </p>
      ) : (
        <ul class="entries">
          {items.map((t) => (
            <Entry text={t} />
          ))}
        </ul>
      )
    }
  </div>
</Base>
