---
import Base from "../../layouts/Base.astro";
import Entry from "../../components/Entry.astro";
import { groupByCategory, textsOf } from "../../lib/texts";

const items = await textsOf("fiction");
const groups = groupByCategory(items, ["原创短篇", "东方同人", "长篇"]);
---

<Base title="作品" description="秦羲子的小说与东方同人。">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Fiction</p>
      <h1>作品</h1>
      <p class="intro">小说、同人，和一些没写完的长篇。按类目放，不按时间。</p>
    </header>

    {
      groups.map((g) => (
        <section>
          <div class="section-head">
            <h2>{g.category}</h2>
            <span class="more">{g.items.length} 篇</span>
          </div>
          <ul class="entries">
            {g.items.map((t) => (
              <Entry text={t} />
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
