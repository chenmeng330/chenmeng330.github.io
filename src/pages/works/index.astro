---
import Base from "../../layouts/Base.astro";
import Entry from "../../components/Entry.astro";
import { groupByCategory, textsOf } from "../../lib/texts";

const items = await textsOf("work");
const groups = groupByCategory(items, ["“她”的写作", "东方同人", "考据"]);
---

<Base title="作品" description="秦羲子的小说、同人与考据长文。">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Works</p>
      <h1>作品</h1>
      <p class="intro">
        只是一些长文章，小说或是“论文”。
      </p>
    </header>

    {
      groups.map((g) => (
        <section>
          <div class="section-head">
            <h2>{g.category}</h2>
            <span class="more">{g.items.length} 篇</span>
          </div>
          <ul class="entries">
            {g.items.map((t) => (
              <Entry text={t} />
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
